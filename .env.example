# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it. These SUPABASE_* / VITE_SUPABASE_* values are the
# publishable (anon) key and project URL/ID, safe to ship to the client —
# do not put the service role key or any Resend/other secret key here or
# in anything prefixed VITE_, since that prefix gets bundled into the
# client build. Server-only secrets (RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
# etc.) belong in your deploy platform's environment settings (Vercel
# project env vars), not in this file.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
