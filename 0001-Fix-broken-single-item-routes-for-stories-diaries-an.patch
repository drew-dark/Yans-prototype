 ....tsx => collection_.dear-today_.$slug.tsx} |   2 +-
 .../{diaries.$slug.tsx => diaries_.$slug.tsx} |   2 +-
 .../{stories.$slug.tsx => stories_.$slug.tsx} |   2 +-
